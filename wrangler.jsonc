{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "seachat",
  "main": "cloudflare/worker.mjs",
  "compatibility_date": "2026-10-08",
  "workers_dev": true,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "seachat",
      "database_id": "ecb3112b-268a-4253-89bc-cc71d1667b4d",
      "migrations_dir": "cloudflare/migrations"
    }
  ],
  "ratelimits": [
    {
      "name": "REQUEST_LIMIT",
      "namespace_id": "88001",
      "simple": {
        "limit": 180,
        "period": 60
      }
    },
    {
      "name": "SESSION_LIMIT",
      "namespace_id": "88002",
      "simple": {
        "limit": 5,
        "period": 60
      }
    },
    {
      "name": "WRITE_LIMIT",
      "namespace_id": "88003",
      "simple": {
        "limit": 20,
        "period": 60
      }
    }
  ],
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "invocation_logs": true,
      "head_sampling_rate": 0.1
    },
    "traces": {
      "head_sampling_rate": 0.01,
      "enabled": true
    }
  }
}